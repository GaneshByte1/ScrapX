    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo || true"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "@repo/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "rimraf": "^5.0.5"
  }
}
